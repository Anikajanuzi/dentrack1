# ─────────────────────────────────────────────────────────────
# DENTRACK environment variables. Copy to .env.local and fill in.
# Never commit real values. Nothing below is sent to the browser
# except variables prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection used by the server (server-only).
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# The app switches to the `authenticated` role per request, so Row Level Security always applies.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=5

# Authentication provider: "supabase" (production) or "local" (development/CI only).
AUTH_PROVIDER=supabase

# Supabase Auth (Project Settings → API). The anon key is designed to be public.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Optional, server-only: lets administrators email team invitations through Supabase.
# Without it, invitations are still saved and people join by signing up with the invited email.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployment (used in password-reset and confirmation links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local auth only (AUTH_PROVIDER=local): secret for signing session cookies (32+ characters).
SESSION_SECRET=
# Local auth is refused in production builds unless this is set deliberately (e.g. CI preview).
ALLOW_LOCAL_AUTH=
